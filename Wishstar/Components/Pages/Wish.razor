@page "/wish"
@page "/wish/{WishId:int}"
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject UserSession Session
@inject WishDraftStore Drafts

<PageTitle>💫 @(IsEdit ? "Edit wish" : "New wish") – Wishstar</PageTitle>

@if (_notFound)
{
    <FormPage Title="Wish not found" OnBack="GoBackAsync">
        <p class="muted">This wish doesn't exist anymore. It may have been deleted.</p>
        <div class="form-actions">
            <button type="button" class="btn btn-primary" @onclick="GoBackAsync">Back to the wishlist</button>
        </div>
    </FormPage>
}
else if (_wish != null)
{
    <FormPage Title="@(IsEdit ? "Edit wish" : "New wish")" Error="@_error" OnBack="GoBackAsync">
        <form class="form" data-no-native-submit @onsubmit="SaveAsync" novalidate>
            <div class="image-upload">
                <label class="upload-preview @(_uploading ? "is-busy" : null) @(HasImage ? "has-image" : null)" for="wish-image">
                    @if (HasImage)
                    {
                        <img src="@ImageStore.GetUrl(_wish.ImageName, ImageVariant.Medium)" alt="Wish photo" />
                    }
                    else
                    {
                        <i class="fas fa-camera" aria-hidden="true"></i>
                        <span>Add a photo</span>
                    }
                    @if (_uploading)
                    {
                        <span class="upload-overlay">
                            <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
                            <span>Uploading…</span>
                        </span>
                    }
                </label>
                <input type="file" id="wish-image" class="visually-hidden" accept="image/*"
                       @ref="_fileInput" @onchange="OnFileSelectedAsync" disabled="@_uploading" />
                @if (HasImage && !_uploading)
                {
                    <label class="link-btn" for="wish-image">Change photo</label>
                }
            </div>

            <div class="field">
                <label for="wish-name">Name <span class="required" aria-hidden="true">*</span></label>
                <input id="wish-name" class="input" type="text" required maxlength="@WishService.MaxNameLength"
                       placeholder="What do you wish for?" @bind="_wish.ItemName" />
            </div>

            <div class="field">
                <span class="field-label" id="rating-label">How much do you want it?</span>
                <StarRating @bind-Value="_wish.Rating" />
            </div>

            <div class="field">
                <label for="wish-description">Description</label>
                <textarea id="wish-description" class="input" rows="3" maxlength="@WishService.MaxDescriptionLength"
                          placeholder="Size, color, variant, notes…" @bind="_wish.ItemDescription"></textarea>
            </div>

            <div class="field">
                <label for="wish-link">Product link <span class="required" aria-hidden="true">*</span></label>
                <input id="wish-link" class="input" type="url" inputmode="url" autocomplete="url" required
                       placeholder="https://example.com/product" @bind="_wish.ProductLink" />
            </div>

            <div class="field-grid">
                <div class="field">
                    <label for="wish-price">Price <span class="required" aria-hidden="true">*</span></label>
                    <div class="input-group">
                        <input id="wish-price" class="input" type="number" inputmode="decimal" min="0" step="0.01"
                               placeholder="0.00" @bind="PriceAmount" />
                        <select class="select" aria-label="Currency" value="@Currency" @onchange="OnCurrencyChanged">
                            @foreach (var currency in CurrencyDescriptor.GetAllCurrencies())
                            {
                                <option value="@currency.Code">@currency.Code</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="field">
                    <label for="wish-vendor">Vendor</label>
                    <div class="input-group">
                        <select id="wish-vendor" class="select" @bind="_wish.VendorId">
                            @foreach (var vendor in _vendors)
                            {
                                <option value="@vendor.VendorId">@vendor.VendorName</option>
                            }
                        </select>
                        <button type="button" class="btn btn-soft btn-icon" title="New vendor" aria-label="New vendor" @onclick="AddVendorAsync">
                            <i class="fas fa-plus" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="field">
                    <label for="wish-category">Category</label>
                    <div class="input-group">
                        <select id="wish-category" class="select" @bind="_wish.CategoryId">
                            @foreach (var category in _categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </select>
                        <button type="button" class="btn btn-soft btn-icon" title="New category" aria-label="New category" @onclick="AddCategoryAsync">
                            <i class="fas fa-plus" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>

                <div class="field field-switch">
                    <label class="switch">
                        <input type="checkbox" @bind="_wish.PrivateItem" />
                        <span class="switch-track" aria-hidden="true"></span>
                        <span>
                            <strong>Private</strong>
                            <small>Only visible when logged in</small>
                        </span>
                    </label>
                </div>
            </div>

            <div class="form-actions">
                @if (IsEdit)
                {
                    <button type="button" class="btn btn-danger-soft" @onclick="ConfirmDelete" disabled="@_saving">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                        <span>Delete</span>
                    </button>
                }
                <span class="spacer"></span>
                <button type="button" class="btn btn-ghost" @onclick="GoBackAsync" disabled="@_saving">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@(_saving || _uploading)">
                    @if (_saving)
                    {
                        <i class="fas fa-circle-notch fa-spin" aria-hidden="true"></i>
                        <span>Saving…</span>
                    }
                    else
                    {
                        <i class="fas fa-check" aria-hidden="true"></i>
                        <span>Save wish</span>
                    }
                </button>
            </div>
        </form>
    </FormPage>

    <ConfirmDialog @ref="_confirm" Title="Delete wish?" />
}
