@page "/category"
@page "/category/{CategoryId:int}"
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject UserSession Session
@inject WishDraftStore Drafts

<PageTitle>💫 @(IsEdit ? "Edit category" : "New category") – Wishstar</PageTitle>

@if (_category != null)
{
    <FormPage Title="@(IsEdit ? "Edit category" : "New category")" Error="@_error" OnBack="GoBackAsync">
        <form class="form" data-no-native-submit @onsubmit="SaveAsync" novalidate>
            <div class="field">
                <label for="category-name">Name <span class="required" aria-hidden="true">*</span></label>
                <input id="category-name" class="input" type="text" required maxlength="@WishService.MaxNameLength"
                       placeholder="e.g. Books" @bind="_category.CategoryName" />
            </div>

            <div class="field">
                <label for="category-description">Description</label>
                <input id="category-description" class="input" type="text" maxlength="@WishService.MaxDescriptionLength"
                       placeholder="Optional" @bind="_category.CategoryDescription" />
            </div>

            <div class="form-actions">
                @if (IsEdit)
                {
                    <button type="button" class="btn btn-danger-soft" @onclick="ConfirmDelete" disabled="@_saving">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                        <span>Delete</span>
                    </button>
                }
                <span class="spacer"></span>
                <button type="button" class="btn btn-ghost" @onclick="GoBackAsync" disabled="@_saving">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    <i class="fas @(_saving ? "fa-circle-notch fa-spin" : "fa-check")" aria-hidden="true"></i>
                    <span>@(IsEdit ? "Save category" : "Add category")</span>
                </button>
            </div>
        </form>
    </FormPage>

    <ConfirmDialog @ref="_confirm" Title="Delete category?" />
}
else if (_notFound)
{
    <FormPage Title="Category not found" OnBack="GoBackAsync">
        <p class="muted">This category doesn't exist anymore.</p>
    </FormPage>
}

@code {
    [Parameter] public int? CategoryId { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private WishCategory? _category;
    private ConfirmDialog? _confirm;
    private string? _error;
    private bool _saving;
    private bool _notFound;

    private bool IsEdit => CategoryId.HasValue;

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn)
        {
            NavigationManager.RedirectToLogin();
            return;
        }

        if (CategoryId is int id)
        {
            if (id == WishCategory.GetUncategorized().CategoryId || WishDatabase.Load().GetCategoryById(id) is not { } existing)
            {
                _notFound = true;
                return;
            }

            _category = (WishCategory)existing.Clone();
        }
        else
        {
            _category = WishCategory.CreateDefault();
        }
    }

    private async Task SaveAsync()
    {
        if (_category == null || _saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = IsEdit ? WishService.UpdateCategory(_category) : WishService.AddCategory(_category);
        if (!result.Success)
        {
            _error = result.Error;
            _saving = false;
            return;
        }

        if (!IsEdit)
        {
            Drafts.CreatedCategoryId = _category.CategoryId;
        }

        await GoBackAsync();
    }

    private void ConfirmDelete()
    {
        if (_category == null || _confirm == null)
        {
            return;
        }

        _confirm.Show($"\"{_category.CategoryName}\" will be deleted. Its wishes are moved to \"Uncategorized\".", async () =>
        {
            var result = WishService.DeleteCategory(_category.CategoryId);
            if (!result.Success)
            {
                _error = result.Error;
                return;
            }

            await GoBackAsync();
        });
    }

    private async Task GoBackAsync()
    {
        if (!await JS.InvokeAsync<bool>("wishstar.nav.back"))
        {
            NavigationManager.NavigateTo(NavigationHelper.SafeReturnUrl(ReturnUrl), replace: true);
        }
    }
}
