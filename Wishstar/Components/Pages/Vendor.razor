@page "/vendor"
@page "/vendor/{VendorId:int}"
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject UserSession Session
@inject WishDraftStore Drafts

<PageTitle>💫 @(IsEdit ? "Edit vendor" : "New vendor") – Wishstar</PageTitle>

@if (_vendor != null)
{
    <FormPage Title="@(IsEdit ? "Edit vendor" : "New vendor")" Error="@_error" OnBack="GoBackAsync">
        <form class="form" data-no-native-submit @onsubmit="SaveAsync" novalidate>
            <div class="field">
                <label for="vendor-name">Name <span class="required" aria-hidden="true">*</span></label>
                <input id="vendor-name" class="input" type="text" required maxlength="@WishService.MaxNameLength"
                       placeholder="e.g. Etsy" @bind="_vendor.VendorName" />
            </div>

            <div class="field">
                <label for="vendor-url">Website <span class="required" aria-hidden="true">*</span></label>
                <input id="vendor-url" class="input" type="url" inputmode="url" required
                       placeholder="https://example.com" @bind="_vendor.Website" />
            </div>

            <div class="form-actions">
                @if (IsEdit)
                {
                    <button type="button" class="btn btn-danger-soft" @onclick="ConfirmDelete" disabled="@_saving">
                        <i class="fas fa-trash" aria-hidden="true"></i>
                        <span>Delete</span>
                    </button>
                }
                <span class="spacer"></span>
                <button type="button" class="btn btn-ghost" @onclick="GoBackAsync" disabled="@_saving">Cancel</button>
                <button type="submit" class="btn btn-primary" disabled="@_saving">
                    <i class="fas @(_saving ? "fa-circle-notch fa-spin" : "fa-check")" aria-hidden="true"></i>
                    <span>@(IsEdit ? "Save vendor" : "Add vendor")</span>
                </button>
            </div>
        </form>
    </FormPage>

    <ConfirmDialog @ref="_confirm" Title="Delete vendor?" />
}
else if (_notFound)
{
    <FormPage Title="Vendor not found" OnBack="GoBackAsync">
        <p class="muted">This vendor doesn't exist anymore.</p>
    </FormPage>
}

@code {
    [Parameter] public int? VendorId { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private Models.Vendor? _vendor;
    private ConfirmDialog? _confirm;
    private string? _error;
    private bool _saving;
    private bool _notFound;

    private bool IsEdit => VendorId.HasValue;

    protected override void OnInitialized()
    {
        if (!Session.IsLoggedIn)
        {
            NavigationManager.RedirectToLogin();
            return;
        }

        if (VendorId is int id)
        {
            if (id == Models.Vendor.GetUnspecified().VendorId || WishDatabase.Load().GetVendorById(id) is not { } existing)
            {
                _notFound = true;
                return;
            }

            _vendor = (Models.Vendor)existing.Clone();
        }
        else
        {
            _vendor = Models.Vendor.CreateDefault();
        }
    }

    private async Task SaveAsync()
    {
        if (_vendor == null || _saving)
        {
            return;
        }

        _saving = true;
        _error = null;
        var result = IsEdit ? WishService.UpdateVendor(_vendor) : WishService.AddVendor(_vendor);
        if (!result.Success)
        {
            _error = result.Error;
            _saving = false;
            return;
        }

        if (!IsEdit)
        {
            Drafts.CreatedVendorId = _vendor.VendorId;
        }

        await GoBackAsync();
    }

    private void ConfirmDelete()
    {
        if (_vendor == null || _confirm == null)
        {
            return;
        }

        _confirm.Show($"\"{_vendor.VendorName}\" will be deleted. Its wishes keep existing without a vendor.", async () =>
        {
            var result = WishService.DeleteVendor(_vendor.VendorId);
            if (!result.Success)
            {
                _error = result.Error;
                return;
            }

            await GoBackAsync();
        });
    }

    private async Task GoBackAsync()
    {
        if (!await JS.InvokeAsync<bool>("wishstar.nav.back"))
        {
            NavigationManager.NavigateTo(NavigationHelper.SafeReturnUrl(ReturnUrl), replace: true);
        }
    }
}
