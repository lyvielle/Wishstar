@page "/login"
@attribute [ExcludeFromInteractiveRouting]
@using Wishstar.Extensions
@inject NavigationManager NavigationManager

@* Rendered statically: the form is handled by js/app.js, so it works instantly without a server connection. *@

<PageTitle>💫 Sign in – Wishstar</PageTitle>

<div class="page page-center">
    <div class="surface login-card">
        <div class="login-header">
            <div class="logo">💫 Wishstar</div>
            <h1>Welcome back</h1>
        </div>

        <form class="form" data-login-form data-return-url="@ReturnTo" method="post" action="/login" novalidate>
            <div class="alert alert-error" data-login-error role="alert" hidden></div>

            <div class="field">
                <label for="email">Email</label>
                <input id="email" name="email" class="input" type="email" autocomplete="username" inputmode="email"
                       placeholder="you@example.com" required autofocus />
            </div>

            <div class="field">
                <label for="password">Password</label>
                <input id="password" name="password" class="input" type="password" autocomplete="current-password"
                       placeholder="••••••••" required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                <i class="fas fa-right-to-bracket" aria-hidden="true"></i>
                <span>Sign in</span>
            </button>
        </form>

        <a class="link-btn login-back" href="/wishlist">
            <i class="fas fa-arrow-left" aria-hidden="true"></i> Back to the wishlist
        </a>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private string ReturnTo => NavigationHelper.SafeReturnUrl(ReturnUrl);

    protected override void OnInitialized()
    {
        if (HttpContext?.Request.GetCurrentUser() != null)
        {
            NavigationManager.NavigateTo(ReturnTo);
        }
    }
}
