<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- .NET 10 ships _framework/blazor.web.js in a package that the SDK only references when it sees
         .razor files during restore. The Dockerfile restores with just this .csproj (for layer caching),
         so without this the script is missing from the published app and Blazor never starts. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT licensed image processing (WebP encoding, resizing). The NoDependencies native
         asset works on the slim Debian-based ASP.NET container image without extra packages. -->
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime data (configs, images, keys) must never be published or built into the image. -->
    <Content Remove="app/**" />
    <None Remove="app/**" />
  </ItemGroup>

</Project>
