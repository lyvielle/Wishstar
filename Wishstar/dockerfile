# Build & publish
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["Wishstar.csproj", "."]
RUN dotnet restore "Wishstar.csproj"
COPY . .
RUN dotnet publish "Wishstar.csproj" -c Release -o /app/publish --no-restore /p:UseAppHost=false

# Runtime
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS final
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_HTTP_PORTS=8080 \
    DOTNET_gcServer=0
COPY --from=build /app/publish .
# Configs, images and login keys live in ./app (mount it as a volume, see docker-compose.yml).
VOLUME ["/app/app"]
ENTRYPOINT ["dotnet", "Wishstar.dll"]
